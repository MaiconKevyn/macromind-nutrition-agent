# ─── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token-here
# Seu Telegram user ID (obter via @userinfobot)
TELEGRAM_ALLOWED_USER_ID=123456789

# ─── LLM ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...           # opcional — Whisper STT via OpenAI
ANTHROPIC_API_KEY=sk-ant-...    # Claude (extração de macros)
GROQ_API_KEY=gsk_...            # Groq — Whisper STT free tier + fallback LLM
LLM_MODEL=claude-haiku-4-5-20251001  # modelo padrão (mais barato)
STT_PROVIDER=groq               # "groq" (free) ou "whisper" (OpenAI pago)

# ─── Banco de dados ───────────────────────────────────────────
# Supabase → Settings → Database → Connection string
# Se você já tiver uma URL com +asyncpg, o app converte automaticamente para o driver síncrono usado no bot.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/macromind

# ─── Observabilidade ─────────────────────────────────────────
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
LANGFUSE_PUBLIC_KEY=            # opcional — tracing LLM
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=                     # opcional — error tracking

# ─── Armazenamento ───────────────────────────────────────────
AUDIO_STORAGE_PATH=data/audio   # caminho local para áudios temporários

# ─── Agendamento ─────────────────────────────────────────────
# Relatório semanal: domingo às 20h (formato cron)
WEEKLY_REPORT_CRON=0 20 * * 0
WEEKLY_REPORT_TIMEZONE=America/Sao_Paulo
